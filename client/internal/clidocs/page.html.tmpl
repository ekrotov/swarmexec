<body>
  <a class="skip" href="#main">Skip to content</a>
{{.Nav}}
  <main id="main">
    <div class="card">
      <p class="crumbs"><a href="/">swarmexec</a> › <a href="/docs">Docs</a> › CLI reference</p>
      <h1>CLI reference<span class="cursor">_</span></h1>
      <p class="tagline">Every command and flag, from the binary's own help.</p>

      <p class="lead">
        This page is generated from the command tree of the <code>swarmexec</code>
        client, so it says what <code>swarmexec &lt;command&gt; --help</code> says.
        The topic pages explain the commands with context and examples; the
        <a href="/docs/parity">parity matrix</a> shows which of them the TUI and the
        MCP server offer too.
      </p>

      <div class="toc">
        <p class="th">Commands</p>
        <ol class="clitoc">
{{- range .Commands}}
          <li class="d{{.Depth}}"><a href="#{{.Anchor}}">{{.Path}}</a></li>
{{- end}}
          <li class="d0"><a href="#global-flags">Global flags</a></li>
          <li class="d0"><a href="#connection-flags">Connection flags</a></li>
        </ol>
      </div>
{{range .Commands}}
      {{if lt .Depth 2}}<h2{{else}}<h3{{end}} id="{{.Anchor}}" class="clicmd"><code>{{.Path}}</code>{{if .Topic}} <span class="clitag">help topic</span>{{end}}{{if lt .Depth 2}}</h2>{{else}}</h3>{{end}}
{{- if .Short}}
      <p class="clishort">{{.Short}}</p>
{{- end}}
{{- if .Usage}}
      <div class="cmd">{{range $i, $u := .Usage}}{{if $i}}
{{end}}{{$u}}{{end}}</div>
{{- end}}
{{- if .Aliases}}
      <p class="climeta">Aliases:{{range .Aliases}} <code>{{.}}</code>{{end}}</p>
{{- end}}
{{- range .Long}}
{{- if eq .Kind "p"}}
      <p>{{.Text}}</p>
{{- else if eq .Kind "label"}}
      <p class="climeta">{{.Text}}</p>
{{- else if eq .Kind "ul"}}
      <ul>
{{- range .Items}}
        <li>{{.}}</li>
{{- end}}
      </ul>
{{- else}}
      <pre class="helptext">{{.Text}}</pre>
{{- end}}
{{- end}}
{{- if .Example}}
      <p class="climeta">Examples</p>
      <div class="cmd">{{.Example}}</div>
{{- end}}
{{- if .Flags}}
      <div class="tablewrap"><table>
        <thead><tr><th>Flag</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
{{- range .Flags}}
          <tr><td><code>{{.Name}}</code></td><td>{{if .Default}}<code>{{.Default}}</code>{{else}}—{{end}}</td><td>{{.Usage}}</td></tr>
{{- end}}
        </tbody>
      </table></div>
{{- end}}
{{- if .Subs}}
      <p class="climeta">Subcommands</p>
      <ul class="clisubs">
{{- range .Subs}}
        <li><a href="#{{.Anchor}}"><code>{{.Path}}</code></a> — {{.Short}}</li>
{{- end}}
      </ul>
{{- end}}
{{- if .Inherits}}
      <p class="climeta">Also takes the <a href="#global-flags">global flags</a> and the <a href="#connection-flags">connection flags</a>.</p>
{{- end}}
{{end}}
      <h2 id="global-flags">Global flags</h2>
      <p>Every command takes these.</p>
      <div class="tablewrap"><table>
        <thead><tr><th>Flag</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
{{- range .Global}}
          <tr><td><code>{{.Name}}</code></td><td>{{if .Default}}<code>{{.Default}}</code>{{else}}—{{end}}</td><td>{{.Usage}}</td></tr>
{{- end}}
        </tbody>
      </table></div>

      <h2 id="connection-flags">Connection flags</h2>
      <p>
        Every command takes these too; they reach the agents on the nodes. Most setups
        set them once in the <a href="/docs/configuration">config file</a> and never on
        the command line. <code>swarmexec help connection</code> prints them.
      </p>
      <div class="tablewrap"><table>
        <thead><tr><th>Flag</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
{{- range .Connection}}
          <tr><td><code>{{.Name}}</code></td><td>{{if .Default}}<code>{{.Default}}</code>{{else}}—{{end}}</td><td>{{.Usage}}</td></tr>
{{- end}}
        </tbody>
      </table></div>

      <nav class="pager" aria-label="Previous and next page">
        <a class="prev" href="/docs/tui-nodes" rel="prev"><span class="lbl">← Previous</span>TUI: the Nodes tab</a>
        <a class="next" href="/docs/parity" rel="next"><span class="lbl">Next →</span>CLI · TUI · MCP: who does what</a>
      </nav>

{{.DocNav}}

